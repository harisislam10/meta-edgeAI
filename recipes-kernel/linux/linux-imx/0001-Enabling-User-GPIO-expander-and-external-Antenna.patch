From 77478e2d7a8e1e54cf99830bec396378d887a796 Mon Sep 17 00:00:00 2001
From: harisislam10 <islamharis87@gmail.com>
Date: Fri, 6 Mar 2026 12:12:20 +0800
Subject: [PATCH] Enabling User GPIO expander and external Antenna

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 96 +++++++++++++++++---
 1 file changed, 84 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index bcb7d6075f0d..a4689f38e250 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -75,11 +75,11 @@ reg_pcie0: regulator-pcie {
 	reg_usb_vbus: regulator-vbus {
 		compatible = "regulator-fixed";
 		pinctrl-names = "default";
-		pinctrl-0 = <&pinctrl_usb1_vbus>;
+		//pinctrl-0 = <&pinctrl_usb1_vbus>;
 		regulator-name = "USB_VBUS";
 		regulator-min-microvolt = <5000000>;
 		regulator-max-microvolt = <5000000>;
-		gpio = <&gpio1 14 GPIO_ACTIVE_HIGH>;
+		//gpio = <&gpio1 14 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 		regulator-always-on;
 	};
@@ -1101,6 +1101,39 @@ &usdhc3 {
 	status = "okay";
 };
 
+//User GPIO-expander and external antenna-----
+&gpio1 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_gpio_header>;
+};
+
+&gpio2 {
+    pinctrl-names = "default";
+
+    pinctrl-0 = <
+        &pinctrl_gpio_header
+        &pinctrl_wifi_antenna
+    >;
+
+    wifi_antenna_select {
+        gpio-hog;
+        gpios = <20 GPIO_ACTIVE_HIGH>;
+        output-low;   /* LOW = external antenna enabled */
+        line-name = "wifi-ext-antenna-enable";
+    };
+};
+
+&gpio4 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_gpio_header>;
+};
+
+&gpio5 {
+    pinctrl-names = "default";
+    pinctrl-0 = <&pinctrl_gpio_header>;
+};
+//--------------------------------------------------------
+
 &wdog1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_wdog>;
@@ -1269,11 +1302,11 @@ MX8MP_IOMUXC_SPDIF_TX__I2C5_SCL         0x400001c2
 		>;
 	};
 
-	pinctrl_mipi_dsi_en: mipi_dsi_en {
-		fsl,pins = <
-			MX8MP_IOMUXC_GPIO1_IO08__GPIO1_IO08	0x16
-		>;
-	};
+	pinctrl_mipi_dsi_en: mipi_dsi_en {
+		fsl,pins = <
+			MX8MP_IOMUXC_GPIO1_IO08__GPIO1_IO08	0x16
+		>;
+	};
 
 	pinctrl_pcie0: pcie0grp {
 		fsl,pins = <
@@ -1396,11 +1429,11 @@ MX8MP_IOMUXC_UART2_TXD__UART2_DCE_TX	0x140
 		>;
 	};
 
-	pinctrl_usb1_vbus: usb1grp {
-		fsl,pins = <
-			MX8MP_IOMUXC_GPIO1_IO14__GPIO1_IO14		0x10
-		>;
-	};
+	//pinctrl_usb1_vbus: usb1grp {
+	//	fsl,pins = <
+	//		MX8MP_IOMUXC_GPIO1_IO14__GPIO1_IO14		0x10
+	//	>;
+	//};
 
 	pinctrl_uart3: uart3grp {
 		fsl,pins = <
@@ -1572,6 +1605,45 @@ pinctrl_csi_mclk: csi_mclk_grp {
 			MX8MP_IOMUXC_GPIO1_IO15__CCM_CLKO2	0x50
 		>;
 	};
+	// Adding pincontrol for user-gpio-headers--------------------------------------------
+    pinctrl_gpio_header: gpioheadergrp {
+        fsl,pins = <
+
+            /* Header 31 */
+            MX8MP_IOMUXC_GPIO1_IO01__GPIO1_IO01 0x1c4
+
+            /* Header 33 */
+            MX8MP_IOMUXC_GPIO1_IO07__GPIO1_IO07 0x1c4
+
+            /* Header 35 */
+            MX8MP_IOMUXC_GPIO1_IO08__GPIO1_IO08 0x1c4 
+
+            /* Header 37 */
+            MX8MP_IOMUXC_GPIO1_IO00__GPIO1_IO00 0x1c4
+
+            /* Header 39 */
+            MX8MP_IOMUXC_GPIO1_IO10__GPIO1_IO10 0x1c4
+
+            /* Header 32 */
+            MX8MP_IOMUXC_SD1_STROBE__GPIO2_IO11 0x10
+
+            /* Header 29 */
+            MX8MP_IOMUXC_GPIO1_IO11__GPIO1_IO11 0x1c4
+
+            /* Header 34 */
+            MX8MP_IOMUXC_SAI3_RXC__GPIO4_IO29 0x1c4
+
+            /* Header 36 */
+            MX8MP_IOMUXC_SPDIF_EXT_CLK__GPIO5_IO05 0x1c4
+
+            /* Header 38 */
+            MX8MP_IOMUXC_GPIO1_IO14__GPIO1_IO14 0x1c4
+
+            /* Header 40 */
+            MX8MP_IOMUXC_GPIO1_IO15__GPIO1_IO15 0x1c4
+        >;
+    };
+	//-----------------------------------------------------------------------------------------------
 };
 
 &vpu_g1 {
-- 
2.34.1

