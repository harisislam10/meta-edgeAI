From b551b9d7d13beb3c90549acb9d1e9cfdc5094e0d Mon Sep 17 00:00:00 2001
From: harisislam10 <islamharis87@gmail.com>
Date: Mon, 3 Nov 2025 15:55:08 +0800
Subject: [PATCH] Enabling SD card

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 48 ++++++++++----------
 1 file changed, 24 insertions(+), 24 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index a9518e0b6e5d..e8530b373eb4 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -84,16 +84,16 @@ reg_usb_vbus: regulator-vbus {
 		regulator-always-on;
 	};
 
-	//reg_usdhc2_vmmc: regulator-usdhc2 {
-	//	compatible = "regulator-fixed";
-	//	pinctrl-names = "default";
-	//	pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
-	//	regulator-name = "VSD_3V3";
-	//	regulator-min-microvolt = <3300000>;
-	//	regulator-max-microvolt = <3300000>;
-	//	gpio = <&gpio2 19 GPIO_ACTIVE_HIGH>;
-	//	enable-active-high;
-	//};
+	reg_usdhc2_vmmc: regulator-usdhc2 {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
+		regulator-name = "VSD_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpio1 04 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
 
 	reg_audio_pwr: regulator-audio-pwr {
 		compatible = "regulator-fixed";
@@ -1110,13 +1110,13 @@ brcmfmac: wifi@0 {
 
 &usdhc2 {
 	assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
-	assigned-clock-rates = <25000000>;//change for 400MHz to 25MHz
+	assigned-clock-rates = <400000000>;//change for 400MHz to 25MHz
 	pinctrl-names = "default", "state_100mhz", "state_200mhz";
 	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
 	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
 	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
-	//cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
-	//vmmc-supply = <&reg_usdhc2_vmmc>;
+	cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
+	vmmc-supply = <&reg_usdhc2_vmmc>;
 	bus-width = <4>;
 	status = "okay";
 
@@ -1341,11 +1341,11 @@ MX8MP_IOMUXC_GPIO1_IO04__GPIO1_IO04  0x1c6
 		>;
 	};
 
-	//pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
-	//	fsl,pins = <
-	//		MX8MP_IOMUXC_SD2_RESET_B__GPIO2_IO19	0x40
-	//	>;
-	//};
+	pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
+		fsl,pins = <
+			MX8MP_IOMUXC_SD2_RESET_B__GPIO2_IO19	0x40
+		>;
+	};
 
 	pinctrl_pdm: pdmgrp {
 		fsl,pins = <
@@ -1444,7 +1444,7 @@ MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0	0x1d0
 			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1	0x1d0
 			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2	0x1d0
 			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3	0x1d0
-			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
 		>;
 	};
 
@@ -1456,7 +1456,7 @@ MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0	0x1d4
 			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1	0x1d4
 			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2	0x1d4
 			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3	0x1d4
-			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
 		>;
 	};
 
@@ -1468,7 +1468,7 @@ MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0	0x1d6
 			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1	0x1d6
 			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2	0x1d6
 			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3	0x1d6
-			//MX8MP_IOMUXC_GPIO1_IO04__USDHC1_VSELECT 0xc0
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC1_VSELECT 0xc0
 		>;
 	};
 
@@ -1480,7 +1480,7 @@ MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d0
 			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d0
 			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d0
 			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d0
-			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
 		>;
 	};
 
@@ -1492,7 +1492,7 @@ MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d4
 			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d4
 			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d4
 			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d4
-			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
 		>;
 	};
 
@@ -1504,7 +1504,7 @@ MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d6
 			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d6
 			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d6
 			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d6
-			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
+			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
 		>;
 	};
 
