From 5e5f13d7324df8af74a53e3d73c6191acaecdf5c Mon Sep 17 00:00:00 2001
From: harisislam10 <islamharis87@gmail.com>
Date: Mon, 3 Nov 2025 17:11:41 +0800
Subject: [PATCH] Enabling SD card-3

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 1e21be3e9048..5f2ef818fae1 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -583,8 +583,8 @@ pcal6408a: gpio@21 {
         #gpio-cells = <2>;
         interrupt-controller;
         #interrupt-cells = <2>;
-        interrupt-parent = <&gpio1>;
-        interrupts = <4 IRQ_TYPE_LEVEL_LOW>; // Example GPIO1_IO12
+        interrupt-parent = <&gpio2>;
+        interrupts = <10 IRQ_TYPE_LEVEL_LOW>; // Example GPIO1_IO12
         pinctrl-names = "default";
         pinctrl-0 = <&pinctrl_pcal6408_int>;
         gpio-line-names = "wl-reg-en", "bt-host-wake", "bt-dev-wake", "wl-host-wake",
@@ -1337,7 +1337,7 @@ MX8MP_IOMUXC_GPIO1_IO03__GPIO1_IO03	0x000001c0
 
 	pinctrl_pcal6408_int: pcal6408-int {
 		fsl,pins = <
-			MX8MP_IOMUXC_GPIO1_IO04__GPIO1_IO04  0x1c6
+			MX8MP_IOMUXC_GPIO2_IO10__GPIO2_IO10  0x1c6
 		>;
 	};
 
-- 
