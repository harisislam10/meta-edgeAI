From 1984439d6b2995ce52f9285039638258d805c3a4 Mon Sep 17 00:00:00 2001
From: Haris Islam <islamharis87@gmail.com>
Date: Thu, 29 May 2025 01:14:35 +0800
Subject: [PATCH] toggle pcal6408 high

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 254d6a345150..fe0f5d47ba16 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -536,8 +536,13 @@ pcal6408a: gpio@21 {
         interrupts = <4 IRQ_TYPE_LEVEL_LOW>; // Example GPIO1_IO12
         pinctrl-names = "default";
         pinctrl-0 = <&pinctrl_pcal6408_int>;
-        gpio-line-names = "P0", "P1", "P2", "P3",
-                          "P4", "P5", "P6", "P7";
+        gpio-line-names = "wl-reg-en", "bt-host-wake", "bt-dev-wake", "wl-host-wake",
+                          "bt-reg-on", "NC", "BT_uart_RTS", "BT_uart_CTS";
+	gpio-hog {
+            gpios = <0 GPIO_ACTIVE_HIGH>,<1 GPIO_ACTIVE_HIGH>, <2 GPIO_ACTIVE_HIGH>, <3 GPIO_ACTIVE_HIGH>,<4 GPIO_ACTIVE_HIGH>;
+            output-high;
+            line-name = "wifi_ble_enable_pins";
+        };
     };
 };
 
