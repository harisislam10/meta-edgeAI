@@ -1034,21 +1034,6 @@ &usdhc2 {
 	bus-width = <4>;
 	status = "okay";
 
-	/*brcmfmac: wifi@0 {
-        compatible = "brcm,cyw4373-sdio";
-        reg = <1>;
