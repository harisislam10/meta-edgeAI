-        interrupt-names = "host-wake";
-        #address-cells = <1>;
-        #size-cells = <0>;
-        core-index = <0>;
-
-        // Wi-Fi Power Enable (WL_REG_EN) connected to PCAL6408A P0
-        enable-gpios = <&pcal6408a 0 GPIO_ACTIVE_HIGH>; // **PCAL6408A Pin P0**
-        post-power-on-delay-ms = <200>; // Recommended delay
-    };/*
 };
 
 &usdhc3 {
