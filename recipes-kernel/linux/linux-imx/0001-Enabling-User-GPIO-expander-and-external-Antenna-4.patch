From 11cc6c5ccc486b7836797bad4eec0be5e2b6eb07 Mon Sep 17 00:00:00 2001
From: harisislam10 <islamharis87@gmail.com>
Date: Tue, 10 Mar 2026 14:54:27 +0800
Subject: [PATCH] Enabling User GPIO expander and external Antenna-4

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 32 +++++++++++++++++---
 1 file changed, 27 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 252f1699825d..77cc88f3530b 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -1104,14 +1104,14 @@ &usdhc3 {
 //User GPIO-expander and external antenna-----
 &gpio1 {
     pinctrl-names = "default";
-    pinctrl-0 = <&pinctrl_gpio_header>;
+    pinctrl-0 = <&pinctrl_gpio1_header>;
 };
 
 &gpio2 {
     pinctrl-names = "default";
 
     pinctrl-0 = <
-        &pinctrl_gpio_header
+        &pinctrl_gpio2_header
         &pinctrl_wifi_antenna
     >;
 
@@ -1125,12 +1125,12 @@ wifi_antenna_select {
 
 &gpio4 {
     pinctrl-names = "default";
-    pinctrl-0 = <&pinctrl_gpio_header>;
+    pinctrl-0 = <&pinctrl_gpio4_header>;
 };
 
 &gpio5 {
     pinctrl-names = "default";
-    pinctrl-0 = <&pinctrl_gpio_header>;
+    pinctrl-0 = <&pinctrl_gpio5_header>;
 };
 //--------------------------------------------------------
 
@@ -1606,7 +1606,7 @@ MX8MP_IOMUXC_GPIO1_IO15__CCM_CLKO2	0x50
 		>;
 	};
 	// Adding pincontrol for user-gpio-headers--------------------------------------------
-    pinctrl_gpio_header: gpioheadergrp {
+    pinctrl_gpio1_header: gpioheadergrp {
         fsl,pins = <
 
             /* Header 31 */
@@ -1642,6 +1642,28 @@ MX8MP_IOMUXC_GPIO1_IO14__GPIO1_IO14 0x1c4
             /* Header 40 */
             MX8MP_IOMUXC_GPIO1_IO15__GPIO1_IO15 0x1c4
         >;
+    };
+	    pinctrl_gpio2_header: gpioheadergrp {
+        fsl,pins = <
+
+            /* Header 32 */
+            MX8MP_IOMUXC_SD1_STROBE__GPIO2_IO11 0x10
+
+        >;
+    };
+	    pinctrl_gpio4_header: gpioheadergrp {
+        fsl,pins = <
+
+            /* Header 34 */
+            MX8MP_IOMUXC_SAI3_RXC__GPIO4_IO29 0x1c4
+        >;
+    };
+	    pinctrl_gpio5_header: gpioheadergrp {
+        fsl,pins = <
+
+            /* Header 36 */
+            MX8MP_IOMUXC_SPDIF_EXT_CLK__GPIO5_IO05 0x1c4
+        >;
     };
 	//-----------------------------------------------------------------------------------------------
 	//External Antenna 
-- 
2.34.1

