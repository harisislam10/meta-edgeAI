Subject: [PATCH] 0001-Falcon-S1-dts-for-edgeAI-v1-5

---
 arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts
index bee43a9706bd..b2b1f1902080 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts
@@ -144,7 +144,8 @@ &flexspi {
 	status = "disabled";
 };
 
-#Adding Sound node on I2C------------------------------------
+//Adding Sound node on I2C------------------------------------
+
 &i2c2 {
 	clock-frequency = <400000>;
 	pinctrl-names = "default";
@@ -159,7 +160,7 @@ codec: nau8822@1a {
 	};
 };
 
-#----------------------------------------------------------
+//----------------------------------------------------------
 
 /delete-node/ &i2c3;
 
@@ -203,12 +204,6 @@ ov5640_mipi_1_ep: endpoint {
 		};
 	};
 
-	codec: wm8960@1a {
-		compatible = "wlf,wm8960,lpa";
-		reg = <0x1a>;
-		wlf,shared-lrclk;
-		SPKVDD1-supply = <&reg_audio_pwr>;
-	};
 };
 
 &pwm4{
