From 7e280ca9c8c365dbd53fa822c338bc430ce232b0 Mon Sep 17 00:00:00 2001
From: Haris Islam <islamharis87@gmail.com>
Date: Sun, 1 Jun 2025 18:35:40 +0800
Subject: [PATCH] changing IMX8MP_CLK_AUDIO_BLK_CTRL_SAI3_MCLK1

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 124b5c847911..ef578dcaa2ce 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -653,7 +653,7 @@ typec_con_ss: endpoint {
 	codec: wm8960@1a {
 		compatible = "wlf,wm8960";
 		reg = <0x1a>;
-		clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SAI5_MCLK1>;
+		clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SAI3_MCLK1>;
 		clock-names = "mclk";
 		wlf,shared-lrclk;
 		wlf,hp-cfg = <3 2 3>;
