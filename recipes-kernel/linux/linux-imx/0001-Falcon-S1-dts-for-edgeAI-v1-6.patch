From f7d41d950d5766b70f8b587d5beca9903c5c0da6 Mon Sep 17 00:00:00 2001
From: harisislam10 <islamharis87@gmail.com>
Date: Wed, 29 Oct 2025 15:05:19 +0800
Subject: [PATCH] Falcon-S1-dts-for-edgeAI-v1-6

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 20bf67f1c958..21de9253bbda 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -69,8 +69,6 @@ reg_pcie0: regulator-pcie {
 		regulator-name = "MPCIE_3V3";
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
-		gpio = <&gpio2 6 GPIO_ACTIVE_HIGH>;
-		enable-active-high;
 		regulator-always-on;
 	};
 
@@ -1281,9 +1279,9 @@ MX8MP_IOMUXC_GPIO1_IO08__GPIO1_IO08	0x16
 
 	pinctrl_pcie0: pcie0grp {
 		fsl,pins = <
-			MX8MP_IOMUXC_I2C4_SCL__PCIE_CLKREQ_B	0x60 /* open drain, pull up */
-			MX8MP_IOMUXC_SD1_DATA5__GPIO2_IO07	0x40
-			MX8MP_IOMUXC_I2C4_SDA__GPIO5_IO21	0x1c4
+			MX8MP_IOMUXC_I2C4_SCL__PCIE_CLKREQ_B   0x60  /* CLKREQ_B */
+			MX8MP_IOMUXC_SD1_DATA5__GPIO2_IO07    0x40  /* RESET_N */
+			MX8MP_IOMUXC_SD1_DATA6__GPIO2_IO08    0x40  /* nPWAKE_N */
 		>;
 	};
 
-- 
2.34.1

