From b6df802b76227bc6ff01ffc7a8336b4e65af677e Mon Sep 17 00:00:00 2001
From: harisislam10 <islamharis87@gmail.com>
Date: Mon, 6 Oct 2025 16:52:14 +0800
Subject: [PATCH] Adding-nau8822-sound-dts_2

---
 arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts
index 62ece668daf5..c9b874db8339 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk-rpmsg.dts
@@ -143,18 +143,18 @@ &flexcan1 {
 &flexspi {
 	status = "disabled";
 };
-&i2c2 {
 
+&i2c2 {
 	clock-frequency = <400000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_i2c2>;
 	status = "okay";
-
-	codec: wm8960@1a {
-		compatible = "wlf,wm8960,lpa";
+	
+	codec: nau8822@1a {
+		compatible = "nuvoton,nau8822";
 		reg = <0x1a>;
-		wlf,shared-lrclk;
-		SPKVDD1-supply = <&reg_audio_pwr>;
+		clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SAI3_MCLK1>;
+		clock-names = "mclk";
 	};
 };
 
-- 
2.34.1

