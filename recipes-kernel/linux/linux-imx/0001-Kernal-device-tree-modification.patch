From: Haris Islam <islamharis87@gmail.com>
Date: Thu, 8 May 2025 13:57:19 +0800
Subject: [PATCH] Kernal device tree modification

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 695d76afdfaf..b4029c2015a3 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -31,8 +31,7 @@ status {
 
 	memory@40000000 {
 		device_type = "memory";
-		reg = <0x0 0x40000000 0 0xc0000000>,
-		      <0x1 0x00000000 0 0xc0000000>;
+		reg = <0x0 0x40000000 0x2 0x00000000>; // 8GB
 	};
 
 	pcie0_refclk: pcie0-refclk {
-- 
