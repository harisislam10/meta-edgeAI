From d3a4c9aaf40ce70426f024eea1004dccb5b7d098 Mon Sep 17 00:00:00 2001
From: Haris Islam <islamharis87@gmail.com>
Date: Mon, 19 May 2025 16:29:24 +0800
Subject: [PATCH] Adding 8-bit Pcal6408a GPIO Expender

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index f74290cff2eb..bf21769789d6 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -525,6 +525,20 @@ ldo5: LDO5 {
 			};
 		};
 	};
+	pcal6408a: gpio@21 {
+    	compatible = "nxp,pcal6408";
+        reg = <0x21>;
+        gpio-controller;
+        #gpio-cells = <2>;
+        interrupt-controller;
+        #interrupt-cells = <2>;
+        interrupt-parent = <&gpio1>;
+        interrupts = <4 IRQ_TYPE_LEVEL_LOW>; // Example GPIO1_IO12
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_pcal6408_int>;
+        gpio-line-names = "P0", "P1", "P2", "P3",
+                          "P4", "P5", "P6", "P7";
+    };
 };
 
 &i2c2 {
-- 
2.34.1

