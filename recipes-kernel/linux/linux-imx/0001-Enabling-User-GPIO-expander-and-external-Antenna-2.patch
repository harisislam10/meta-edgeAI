+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -1644,6 +1644,13 @@ MX8MP_IOMUXC_GPIO1_IO15__GPIO1_IO15 0x1c4
         >;
     };
 	//-----------------------------------------------------------------------------------------------
