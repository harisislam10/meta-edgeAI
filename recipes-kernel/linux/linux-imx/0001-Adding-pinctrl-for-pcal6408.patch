From 28a222b21844d07705fdc4f6dba24fb3959e789d Mon Sep 17 00:00:00 2001
From: Haris Islam <islamharis87@gmail.com>
Date: Mon, 19 May 2025 17:22:40 +0800
Subject: [PATCH] Adding pinctrl for pcal6408

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index bf21769789d6..c377861f7ebe 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -1182,6 +1182,13 @@ MX8MP_IOMUXC_GPIO1_IO12__GPIO1_IO12	0x146 /* Input pull-up. */
 		>;
 	};
 
+	pinctrl_pcal6408_int: pcal6408-int {
+		fsl,pins = <
+			MX8MP_IOMUXC_GPIO1_IO04__GPIO1_IO04  0x1c6
+		>;
+	};
+
+
 	pinctrl_pwm1: pwm1grp {
 		fsl,pins = <
 			MX8MP_IOMUXC_GPIO1_IO01__PWM1_OUT	0x116
-- 
