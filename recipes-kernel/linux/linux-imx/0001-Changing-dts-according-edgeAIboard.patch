From 90798eafddcbfb37358d68a8f6d1e8e88fed5bbc Mon Sep 17 00:00:00 2001
From: Haris Islam <islamharis87@gmail.com>
Date: Fri, 30 May 2025 00:19:31 +0800
Subject: [PATCH] Changing dts according edgeAIboard

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 116 +++++++++++++------
 1 file changed, 83 insertions(+), 33 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 0104b03b6634..7636b3494942 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -86,16 +86,16 @@ reg_usb_vbus: regulator-vbus {
 		regulator-always-on;
 	};
 
-	reg_usdhc2_vmmc: regulator-usdhc2 {
-		compatible = "regulator-fixed";
-		pinctrl-names = "default";
-		pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
-		regulator-name = "VSD_3V3";
-		regulator-min-microvolt = <3300000>;
-		regulator-max-microvolt = <3300000>;
-		gpio = <&gpio2 19 GPIO_ACTIVE_HIGH>;
-		enable-active-high;
-	};
+	//reg_usdhc2_vmmc: regulator-usdhc2 {
+	//	compatible = "regulator-fixed";
+	//	pinctrl-names = "default";
+	//	pinctrl-0 = <&pinctrl_reg_usdhc2_vmmc>;
+	//	regulator-name = "VSD_3V3";
+	//	regulator-min-microvolt = <3300000>;
+	//	regulator-max-microvolt = <3300000>;
+	//	gpio = <&gpio2 19 GPIO_ACTIVE_HIGH>;
+	//	enable-active-high;
+	//};
 
 	reg_audio_pwr: regulator-audio-pwr {
 		compatible = "regulator-fixed";
@@ -528,10 +528,32 @@ ldo5: LDO5 {
 			};
 		};
 	};
+	pcal6408a: gpio@21 {
+    	compatible = "nxp,pcal6408";
+        reg = <0x21>;
+        gpio-controller;
+        #gpio-cells = <2>;
+        interrupt-controller;
+        #interrupt-cells = <2>;
+        interrupt-parent = <&gpio1>;
+        interrupts = <4 IRQ_TYPE_LEVEL_LOW>; // Example GPIO1_IO12
+        pinctrl-names = "default";
+        pinctrl-0 = <&pinctrl_pcal6408_int>;
+        gpio-line-names = "wl-reg-en", "bt-host-wake", "bt-dev-wake", "wl-host-wake",
+                          "bt-reg-on", "NC", "BT_uart_RTS", "BT_uart_CTS";
+		wifi-bt-enable-pins {
+    		gpio-hog;
+    		gpios = <0 GPIO_ACTIVE_HIGH>, // P0: wl-reg-en
+    	        	<2 GPIO_ACTIVE_HIGH>, // P2: bt-dev-wake
+           		 	<4 GPIO_ACTIVE_HIGH>; // P4: bt-reg-on
+    		output-high;
+    		line-name = "murata_wifi_bt_power";
+		};
+	}
 };
 
 &i2c2 {
-	clock-frequency = <100000>;
+	clock-frequency = <400000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_i2c2>;
 	status = "okay";
@@ -628,6 +650,16 @@ typec_con_ss: endpoint {
 			};
 		};
 	};
+	codec: wm8960@1a {
+		compatible = "wlf,wm8960";
+		reg = <0x1a>;
+		clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI3_MCLK1>;
+		clock-names = "mclk";
+		wlf,shared-lrclk;
+		wlf,hp-cfg = <3 2 3>;
+		wlf,gpio-cfg = <1 3>;
+		SPKVDD1-supply = <&reg_audio_pwr>;
+	};
 };
 
 &i2c3 {
@@ -665,17 +697,6 @@ pca6416: gpio@20 {
 			"EXP_P1_7";
 	};
 
-	codec: wm8960@1a {
-		compatible = "wlf,wm8960";
-		reg = <0x1a>;
-		clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIO_BLK_CTRL_SAI3_MCLK1>;
-		clock-names = "mclk";
-		wlf,shared-lrclk;
-		wlf,hp-cfg = <3 2 3>;
-		wlf,gpio-cfg = <1 3>;
-		SPKVDD1-supply = <&reg_audio_pwr>;
-	};
-
 	ov5640_1: ov5640_mipi@3c {
 		compatible = "ovti,ov5640";
 		reg = <0x3c>;
@@ -957,19 +978,48 @@ &uart3 {
 	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_80M>;
 	fsl,uart-has-rtscts;
 	status = "okay";
+
+	bluetooth {
+        compatible = "brcm,bcm4373-bt";
+        max-speed = <3000000>; // Common baud rate for BT, adjust if Murata specifies otherwise
+        
+        // Bluetooth Control GPIOs through PCAL6408A
+        // BT_HOST_WAKE connected to PCAL6408A P1
+        host-wakeup-gpios = <&pcal6408a 1 GPIO_ACTIVE_HIGH>; // **PCAL6408A Pin P1**
+        // BT_DEV_WAKE connected to PCAL6408A P2
+        device-wakeup-gpios = <&pcal6408a 2 GPIO_ACTIVE_HIGH>; // **PCAL6408A Pin P2**
+        // BT_REG_EN (assuming P4 as in previous schematic, if different, adjust)
+        shutdown-gpios = <&pcal6408a 4 GPIO_ACTIVE_HIGH>; // **PCAL6408A Pin P4 (if BT_REG_EN)**
+    };
 };
 
 &usdhc2 {
 	assigned-clocks = <&clk IMX8MP_CLK_USDHC2>;
-	assigned-clock-rates = <400000000>;
+	assigned-clock-rates = <25000000>;//change for 400MHz to 25MHz
 	pinctrl-names = "default", "state_100mhz", "state_200mhz";
 	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
 	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
 	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
-	cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
-	vmmc-supply = <&reg_usdhc2_vmmc>;
+	//cd-gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
+	//vmmc-supply = <&reg_usdhc2_vmmc>;
 	bus-width = <4>;
 	status = "okay";
+
+	brcmfmac: wifi@0 {
+        compatible = "brcm,cyw4373-sdio";
+        reg = <1>;
+        // Wi-Fi Host Wake (WL_HOST_WAKE) from Murata connected to PCAL6408A P3
+        interrupt-parent = <&pcal6408a>;
+        interrupts = <3 IRQ_TYPE_LEVEL_HIGH>; // **PCAL6408A Pin P3**
+        interrupt-names = "host-wake";
+        #address-cells = <1>;
+        #size-cells = <0>;
+        core-index = <0>;
+
+        // Wi-Fi Power Enable (WL_REG_EN) connected to PCAL6408A P0
+        enable-gpios = <&pcal6408a 0 GPIO_ACTIVE_HIGH>; // **PCAL6408A Pin P0**
+        post-power-on-delay-ms = <200>; // Recommended delay
+    };
 };
 
 &usdhc3 {
@@ -1184,11 +1234,11 @@ MX8MP_IOMUXC_GPIO1_IO12__GPIO1_IO12	0x146 /* Input pull-up. */
 		>;
 	};
 
-	pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
-		fsl,pins = <
-			MX8MP_IOMUXC_SD2_RESET_B__GPIO2_IO19	0x40
-		>;
-	};
+	//pinctrl_reg_usdhc2_vmmc: regusdhc2vmmcgrp {
+	//	fsl,pins = <
+	//		MX8MP_IOMUXC_SD2_RESET_B__GPIO2_IO19	0x40
+	//	>;
+	//};
 
 	pinctrl_pdm: pdmgrp {
 		fsl,pins = <
@@ -1278,7 +1328,7 @@ MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d0
 			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d0
 			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d0
 			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d0
-			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
+			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT	0xc0
 		>;
 	};
 
@@ -1290,7 +1340,7 @@ MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d4
 			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d4
 			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d4
 			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d4
-			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
+			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
 		>;
 	};
 
@@ -1302,7 +1352,7 @@ MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d6
 			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d6
 			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d6
 			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d6
-			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
+			//MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
 		>;
 	};
 
-- 
