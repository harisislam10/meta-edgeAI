From b7bcad4341af6a711542524e0dcdb3aaf4f98ca3 Mon Sep 17 00:00:00 2001
From: harisislam10 <islamharis87@gmail.com>
Date: Wed, 1 Oct 2025 15:32:12 +0800
Subject: [PATCH] Porting CSI Camera to Falcon_SBC_9

---
 arch/arm64/boot/dts/freescale/imx8mp-evk.dts | 57 +++++++-------------
 1 file changed, 19 insertions(+), 38 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
index 3e7230c9f132..3e829d0b2526 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mp-evk.dts
@@ -104,31 +104,22 @@ reg_audio_pwr: regulator-audio-pwr {
 		enable-active-high;
 		regulator-always-on;
 	};
-	// regulator for Cameras------------------
-	reg_dovdd: regulator-dovdd {
-		compatible = "regulator-fixed";
-		regulator-name = "dovdd";
-		regulator-min-microvolt = <1800000>;
-		regulator-max-microvolt = <1800000>;
-		regulator-always-on;
-	};
 
-	reg_avdd: regulator-avdd {
-		compatible = "regulator-fixed";
-		regulator-name = "avdd";
-		regulator-min-microvolt = <2800000>;
-		regulator-max-microvolt = <2800000>;
-		regulator-always-on;
-	};
+	/* Regulator for Camera ov5640 */
+	reg_cam1_3v3: regulator-cam1-3v3 {
+        compatible = "regulator-fixed";
+        regulator-name = "cam1_3v3";
+        regulator-min-microvolt = <3300000>;
+        regulator-max-microvolt = <3300000>;
+
+        /* Replace "3" with the actual PCAL6408 pin for CAM1_EN */
+        gpio = <&pca6416 1 GPIO_ACTIVE_HIGH>;
+        enable-active-high;
+
+        /* Delay after EN goes high to let oscillator/LDOs stabilize */
+        startup-delay-us = <5000>;   // 5 ms delay
+    };
 
-	reg_dvdd: regulator-dvdd {
-		compatible = "regulator-fixed";
-		regulator-name = "dvdd";
-		regulator-min-microvolt = <1500000>;
-		regulator-max-microvolt = <1500000>;
-		regulator-always-on;
-	};
-	//---------------------------------------
 	bt_sco_codec: bt_sco_codec {
 		#sound-dai-cells = <1>;
 		compatible = "linux,bt-sco";
@@ -575,7 +566,7 @@ wifi-bt-enable-pins {
 };
 
 &i2c2 {
-	clock-frequency = <100000>;
+	clock-frequency = <400000>;
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_i2c2>;
 	status = "okay";
@@ -611,20 +602,9 @@ ov5640_0: ov5640_mipi@3c {
 		reg = <0x3c>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pinctrl_csi_mclk>;  		/*removing <&pinctrl_csi0_pwn>, <&pinctrl_csi0_rst> */
-		clocks = <&clk IMX8MP_CLK_IPP_DO_CLKO2>;
-		clock-names = "xclk";
-		assigned-clocks = <&clk IMX8MP_CLK_IPP_DO_CLKO2>;
-		assigned-clock-parents = <&clk IMX8MP_CLK_24M>;
-		assigned-clock-rates = <24000000>;
-		AVDD-supply = <&reg_avdd>;
-		DOVDD-supply = <&reg_dovdd>;
-		DVDD-supply = <&reg_dvdd>;
-		mclk = <24000000>;
-		mclk_source = <0>;
-		mipi_csi;
-		csi_id = <0>;
-		//powerdown-gpios = <&pca6416 1 GPIO_ACTIVE_HIGH>;  /* CAM1_EN */
-		//reset-gpios = <&pca6416 2 GPIO_ACTIVE_LOW>;       /* CAM1_RST */
+		AVDD-supply  = <&reg_cam1_3v3>;
+        DVDD-supply  = <&reg_cam1_3v3>;
+        DOVDD-supply = <&reg_cam1_3v3>;
 
 		status = "okay";
 
@@ -633,6 +613,7 @@ ov5640_mipi_0_ep: endpoint {
 				remote-endpoint = <&mipi_csi0_ep>;
 				data-lanes = <1 2>;
 				clock-lanes = <0>;
+				link-frequencies = /bits/ 64 <240000000>;
 			};
 		};
 	};
-- 
2.34.1

