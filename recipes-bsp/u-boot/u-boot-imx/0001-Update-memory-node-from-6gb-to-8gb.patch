From 2d0cd5c9de6e7db4e12a8a1998860987867b0bcc Mon Sep 17 00:00:00 2001
From: Haris Islam <islamharis87@gmail.com>
Date: Thu, 8 May 2025 09:49:06 +0800
Subject: [PATCH] Update memory node from 6gb to 8gb

---
 arch/arm/dts/imx8mp-evk.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm/dts/imx8mp-evk.dts b/arch/arm/dts/imx8mp-evk.dts
index 36b860125e0..9c9965c89de 100644
--- a/arch/arm/dts/imx8mp-evk.dts
+++ b/arch/arm/dts/imx8mp-evk.dts
@@ -31,8 +31,8 @@
 
 	memory@40000000 {
 		device_type = "memory";
-		reg = <0x0 0x40000000 0 0xc0000000>,
-		      <0x1 0x00000000 0 0xc0000000>;
+		reg = <0x0 0x40000000 0x2 0x00000000>;
+
 	};
 
 	pcie0_refclk: pcie0-refclk {
-- 
