Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// Load logo
logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetScale(1); // Prevent scaling

// Create progress bar elements
progress_bar_width = 400;  // Set your desired width
progress_bar_height = 4;
progress_bar_y_offset = 40;  // Space between logo and progress bar

// Progress bar background
progress_bg = Image(progress_bar_width, progress_bar_height);
progress_bg.Clear(44, 44, 44);  // Dark gray background
progress_bg_sprite = Sprite(progress_bg);

// Progress bar foreground
progress_fg = Image(progress_bar_width, progress_bar_height);
progress_fg.Clear(29, 172, 232);  // Bright blue progress
progress_fg_sprite = Sprite(progress_fg);
progress = 0;  // Current progress (0-1)

fun refresh_callback () {
    // Center logo
    logo_x = (Window.GetWidth() - logo.GetWidth()) / 2;
    logo_y = (Window.GetHeight() - logo.GetHeight()) / 2;
    logo_sprite.SetPosition(logo_x, logo_y);

    // Update progress bar
    if (Plymouth.GetMode() == "boot") {
        // Simulate progress - replace this with real progress if available
        progress = progress + 0.005;
        if (progress > 1) progress = 1;
    } else {
        // Shutdown animation
        progress = progress - 0.02;
        if (progress < 0) progress = 0;
    }

    // Position progress bar
    progress_bar_x = (Window.GetWidth() - progress_bar_width) / 2;
    progress_bar_y = logo_y + logo.GetHeight() + progress_bar_y_offset;

    // Update progress bar sprites
    progress_bg_sprite.SetPosition(progress_bar_x, progress_bar_y);
    progress_fg_sprite.SetPosition(progress_bar_x, progress_bar_y);
    progress_fg_sprite.SetWidth(progress_bar_width * progress);
}

// Initial positioning
refresh_callback();
Plymouth.SetRefreshFunction(refresh_callback);